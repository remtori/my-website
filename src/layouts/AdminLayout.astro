---
import Layout from '@/layouts/Layout.astro';

interface Props {
	title: string;
	description?: string;
	full?: boolean;
}

const { title, description, full = false } = Astro.props;
const pathname = Astro.url.pathname;

const sections = [
	{ href: '/admin', label: 'Dashboard', active: pathname === '/admin' || pathname.startsWith('/admin/edit') },
	{ href: '/admin/files', label: 'Files', active: pathname.startsWith('/admin/files') },
];
---

<Layout title={title} description={description} wide={!full} fluid={full}>
	<div class:list={['flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-border pb-4', full ? 'mb-5' : 'mb-10']}>
		<span class="eyebrow eyebrow-accent">Admin</span>

		<nav class="flex items-center gap-5">
			{sections.map((section) => (
				<a
					href={section.href}
					class="navlink"
					aria-current={section.active ? 'page' : undefined}
					transition:animate="none"
				>
					{section.label}
				</a>
			))}
		</nav>

		<form method="POST" action="/api/admin/logout" class="ml-auto">
			<button type="submit" class="btn btn-sm">Sign out</button>
		</form>
	</div>

	<slot />
</Layout>

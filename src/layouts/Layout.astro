---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
	title: string;
	description?: string;
	wide?: boolean;
	fluid?: boolean;
}

const { title, description = 'Personal site', wide = false, fluid = false } = Astro.props;
const pathname = Astro.url.pathname;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/tools', label: 'Tools' },
	{ href: '/archive', label: 'Archive' },
	{ href: '/about', label: 'About' },
];

const current = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
const onAdmin = pathname.startsWith('/admin');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="Remtori" />
		<title>Remtori - {title}</title>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<ClientRouter />
		<script is:inline>
			if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
				navigator.serviceWorker.register('/sw.js');
			}
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-bg-base font-body text-text-primary antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
		>
			Skip to content
		</a>

		<header class="sticky top-0 z-50 border-b border-border bg-bg-base/90 backdrop-blur-md">
			<div class="mx-auto flex max-w-5xl items-center gap-5 px-5 py-3">
				<a
					href="/"
					class="shrink-0 font-display text-[0.9375rem] font-bold tracking-tight text-text-primary transition hover:text-accent"
					transition:animate="none"
				>
					Remtori
				</a>

				<nav class="ml-auto flex items-center gap-4 sm:gap-6">
					{nav.map((item) => (
						<a
							href={item.href}
							class="navlink hidden sm:inline"
							aria-current={current(item.href) ? 'page' : undefined}
							transition:animate="none"
						>
							{item.label}
						</a>
					))}

					<!-- Mobile: the primary two only, so the bar stays readable. -->
					<a href="/blog" class="navlink sm:hidden" aria-current={current('/blog') ? 'page' : undefined} transition:animate="none">
						Blog
					</a>
					<a href="/tools" class="navlink sm:hidden" aria-current={current('/tools') ? 'page' : undefined} transition:animate="none">
						Tools
					</a>

					<a
						href="/admin"
						class="btn btn-sm"
						aria-current={onAdmin ? 'page' : undefined}
						transition:animate="none"
					>
						Admin
					</a>
				</nav>
			</div>
		</header>

		<main
			id="main"
			class:list={[
				'flex-1',
				fluid
					? 'mx-auto w-full max-w-[100rem] px-4 py-6'
					: wide
						? 'mx-auto w-full max-w-5xl px-5 py-12'
						: 'mx-auto w-full max-w-3xl px-5 py-12',
			]}
		>
			<slot />
		</main>

		<footer class="mt-8 border-t border-border">
			<div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-6 text-[13px] text-text-muted">
				<span>&copy; {new Date().getFullYear()} Remtori</span>
				<a href="/about" class="link" transition:animate="none">About</a>
				<a href="/admin" class="link" transition:animate="none">Admin</a>
				<span class="ml-auto font-mono text-[11px]">Astro on Cloudflare Workers</span>
			</div>
		</footer>
	</body>
</html>

---
import Layout from '@/layouts/Layout.astro';
import ObjectRow from '@/components/ObjectRow.astro';
import { getFileIndex } from '@/lib/file-index';
import { POSTS_PREFIX, slugFromPostKey } from '@/lib/s3';
import { tools } from '@/lib/tools';

export const prerender = false;

const index = await getFileIndex();

const allPosts = index
	.filter((e) => e.key.startsWith(POSTS_PREFIX) && e.key.endsWith('.mdx'))
	.map((e) => ({
		slug: slugFromPostKey(e.key),
		title: e.title ?? slugFromPostKey(e.key),
		date: e.date ?? '',
	}))
	.sort((a, b) => b.date.localeCompare(a.date));

const posts = allPosts.slice(0, 6);
const popularTools = tools.filter((t) => t.popular).slice(0, 5);
---

<Layout title="Home" wide={true}>
	<!-- Intro -->
	<section class="rise max-w-2xl">
		<h1 class="u-wide text-3xl text-text-primary sm:text-4xl">Remtori</h1>
		<p class="mt-2 text-[15px] text-text-muted">Systems engineer &amp; writer</p>
		<p class="mt-5 text-lg leading-relaxed text-text-secondary">
			Building things on the internet. Notes on code, infrastructure, and the tools that make it all
			work.
		</p>
	</section>

	<div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-14">
		<!-- Writing -->
		<section class="rise lg:col-span-7" style="--i: 1">
			<div class="flex items-baseline justify-between gap-4 border-b border-border pb-2.5">
				<h2 class="u-wide text-base text-text-primary">Recent writing</h2>
				<a href="/blog" class="text-[13px] text-accent transition hover:underline" transition:animate="none">
					All posts
				</a>
			</div>

			<div>
				{
					posts.length === 0 ? (
						<p class="py-7 text-[15px] text-text-muted">Nothing published yet.</p>
					) : (
						posts.map((post) => (
							<ObjectRow
								href={`/blog/${post.slug}`}
								title={post.title}
								meta={post.date || undefined}
								tag="Writing"
							/>
						))
					)
				}
			</div>
		</section>

		<!-- Tools -->
		<section class="rise lg:col-span-5" style="--i: 2">
			<div class="flex items-baseline justify-between gap-4 border-b border-border pb-2.5">
				<h2 class="u-wide text-base text-text-primary">Tools</h2>
				<a href="/tools" class="text-[13px] text-accent transition hover:underline" transition:animate="none">
					All tools
				</a>
			</div>

			<div>
				{
					popularTools.length === 0 ? (
						<p class="py-7 text-[15px] text-text-muted">No tools yet.</p>
					) : (
						popularTools.map((tool) => (
							<ObjectRow href={tool.href} title={tool.name} desc={tool.desc} tag="Tool" />
						))
					)
				}
			</div>

			<p class="mt-4 text-[13px] leading-relaxed text-text-muted">
				Every tool runs in your browser. Nothing is uploaded.
			</p>
		</section>
	</div>
</Layout>

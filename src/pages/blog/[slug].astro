---
import Layout from '@/layouts/Layout.astro';
import MdBody from '@/components/MdBody.astro';
import { loadMdFromS3 } from '@/lib/md-content';
import { postKeyFromSlug } from '@/lib/s3';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) {
	return Astro.redirect('/blog', 302);
}

const { html, title, date, found } = await loadMdFromS3(postKeyFromSlug(slug));

if (!found) {
	return new Response('Not found', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}
---

<Layout {title}>
	<article>
		<header class="rise">
			<a href="/blog" class="eyebrow transition hover:text-accent" transition:animate="none">
				&larr; Blog
			</a>
			<h1 class="u-title mt-5 text-3xl text-text-primary sm:text-4xl">{title}</h1>
			{date ? <p class="mt-3 font-mono text-xs text-text-muted">{date}</p> : null}
		</header>

		<div class="rise mt-9" style="--i: 1">
			<MdBody {html} />
		</div>

		<footer class="mt-16 border-t border-border pt-6">
			<a href="/blog" class="eyebrow transition hover:text-accent" transition:animate="none">
				&larr; All posts
			</a>
		</footer>
	</article>
</Layout>

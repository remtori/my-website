---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostCard from '@/components/PostCard.astro';
import SearchBar from '@/components/SearchBar.astro';
import { getFileIndex } from '@/lib/file-index';
import { POSTS_PREFIX, slugFromPostKey } from '@/lib/s3';

export const prerender = false;

const index = await getFileIndex();

const items = index
	.filter((e) => e.key.startsWith(POSTS_PREFIX) && e.key.endsWith('.mdx'))
	.map((e) => ({
		slug: slugFromPostKey(e.key),
		title: e.title ?? slugFromPostKey(e.key),
		date: e.date ?? '',
	}));

items.sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="Blog">
	<PageHeader title="Blog" subtitle="Thoughts, notes, and write-ups." size="lg" />

	<div class="rise mt-12" style="--i: 1">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<span class="eyebrow">{items.length} {items.length === 1 ? 'post' : 'posts'}</span>
			<div class="w-full sm:w-72"><SearchBar id="blog-search" placeholder="Filter posts" /></div>
		</div>

		<ul class="mt-6 border-t border-border">
			{
				items.length === 0 ? (
					<li class="py-10">
						<p class="text-lg text-text-secondary">No posts yet.</p>
						<p class="mt-2 font-mono text-xs leading-relaxed text-text-muted">
							Add .mdx files under mdx/blogs/ in S3, then open a post URL.
						</p>
					</li>
				) : (
					items.map((p) => (
						<PostCard
							href={`/blog/${p.slug}`}
							title={p.title}
							date={p.date || undefined}
							dataAttrs={{ 'data-title': p.title }}
						/>
					))
				)
			}
			<li id="blog-empty" class="hidden py-10">
				<p class="text-lg text-text-secondary">No posts matched that filter.</p>
			</li>
		</ul>
	</div>

	<script is:inline>
		(function () {
			function initBlogSearch() {
				const input = document.getElementById('blog-search');
				const rows = document.querySelectorAll('.blog-row');
				const empty = document.getElementById('blog-empty');
				if (!input || !empty) return;
				if (input.dataset.blogSearchReady === 'true') return;
				input.dataset.blogSearchReady = 'true';

				input.addEventListener('input', function () {
					const q = this.value.toLowerCase().trim();
					let visible = 0;
					rows.forEach(function (row) {
						const title = (row.getAttribute('data-title') || '').toLowerCase();
						const match = title.includes(q);
						row.style.display = match ? '' : 'none';
						if (match) visible++;
					});
					empty.style.display = visible === 0 ? 'block' : 'none';
				});
			}

			document.addEventListener('astro:page-load', initBlogSearch);
			initBlogSearch();
		})();
	</script>
</Layout>

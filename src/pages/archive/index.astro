---
import ObjectRow from '@/components/ObjectRow.astro';
import PageHeader from '@/components/PageHeader.astro';
import SearchBar from '@/components/SearchBar.astro';
import Layout from '@/layouts/Layout.astro';
import { archiveItems } from '@/lib/archive';

export const prerender = false;
---

<Layout title="Archive">
	<PageHeader
		title="Archive"
		subtitle="Recovered older projects, experiments, and web artifacts."
		size="lg"
	/>

	<div class="rise mt-12" style="--i: 1">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<span class="eyebrow">
				{archiveItems.length} artifact{archiveItems.length === 1 ? '' : 's'}
			</span>
			<div class="w-full sm:w-72">
				<SearchBar id="archive-search" placeholder="Filter archive" />
			</div>
		</div>

		<ul class="mt-6 border-t border-border">
			{
				archiveItems.map((item) => (
					<li
						class="archive-row"
						data-title={item.title}
						data-description={item.description}
						data-kind={item.kind}
					>
						<ObjectRow
							href={item.href}
							title={item.title}
							meta={item.date}
							desc={item.description}
							tag={item.kind}
							dataAttrs={{ 'data-astro-reload': 'true' }}
						/>
					</li>
				))
			}
			<li id="archive-empty" class="hidden py-10">
				<p class="text-lg text-text-secondary">No artifacts matched that filter.</p>
			</li>
		</ul>
	</div>

	<script is:inline>
		(function () {
			function initArchiveSearch() {
				const input = document.getElementById('archive-search');
				const rows = document.querySelectorAll('.archive-row');
				const empty = document.getElementById('archive-empty');
				if (!input || !empty) return;
				if (input.dataset.archiveSearchReady === 'true') return;
				input.dataset.archiveSearchReady = 'true';

				input.addEventListener('input', function () {
					const q = this.value.toLowerCase().trim();
					let visible = 0;
					rows.forEach(function (row) {
						const title = (row.getAttribute('data-title') || '').toLowerCase();
						const desc = (row.getAttribute('data-description') || '').toLowerCase();
						const kind = (row.getAttribute('data-kind') || '').toLowerCase();
						const match = title.includes(q) || desc.includes(q) || kind.includes(q);
						row.style.display = match ? '' : 'none';
						if (match) visible++;
					});
					empty.style.display = visible === 0 ? 'block' : 'none';
				});
			}

			document.addEventListener('astro:page-load', initArchiveSearch);
			initArchiveSearch();
		})();
	</script>
</Layout>

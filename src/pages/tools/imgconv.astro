---
import Layout from '@/layouts/Layout.astro';

export const prerender = false;

const primaryFormats = [
	{ value: 'jpeg', label: 'JPEG', checked: true },
	{ value: 'png', label: 'PNG', checked: false },
	{ value: 'webp', label: 'WebP', checked: false },
	{ value: 'avif', label: 'AVIF', checked: false },
];

const moreFormats = [
	{ value: 'heic', label: 'HEIC' },
	{ value: 'jxl', label: 'JPEG XL' },
	{ value: 'tiff', label: 'TIFF' },
	{ value: 'gif', label: 'GIF' },
	{ value: 'ppm', label: 'PPM' },
	{ value: 'hdr', label: 'HDR' },
	{ value: 'uhdr', label: 'Ultra HDR' },
	{ value: 'raw', label: 'Raw pixels' },
	{ value: 'csv', label: 'Pixel CSV' },
];

const checkRow = 'flex cursor-pointer items-center gap-2.5 text-sm text-text-secondary transition hover:text-text-primary';
const pill =
	'block cursor-pointer select-none border border-border px-4 py-2 font-mono text-sm text-text-secondary transition hover:border-accent hover:text-accent peer-checked:border-accent peer-checked:bg-accent peer-checked:font-semibold peer-checked:text-bg-muted peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent';
const pillSmall =
	'block cursor-pointer select-none border border-border px-3 py-1.5 font-mono text-xs text-text-secondary transition hover:border-accent hover:text-accent peer-checked:border-accent peer-checked:bg-accent peer-checked:font-semibold peer-checked:text-bg-muted peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent';
const summaryStyle =
	'eyebrow flex cursor-pointer select-none items-center gap-2.5 px-4 py-3.5 transition hover:text-accent [&::-webkit-details-marker]:hidden [&::marker]:content-none';
const summaryMeta = 'ml-auto font-mono text-[10px] normal-case tracking-normal text-text-muted';
---

<Layout
	title="imgconv"
	description="Convert, resize, and compress images entirely in your browser. Nothing gets uploaded."
	wide={true}
>
	<div id="image-tool" class="mx-auto max-w-5xl">
		<!-- Header -->
		<header class="rise">
			<p class="eyebrow eyebrow-accent">Tool</p>
			<h1 class="u-title mt-2 text-3xl text-text-primary sm:text-4xl">imgconv</h1>
			<p class="mt-3 max-w-xl text-[15px] leading-relaxed text-text-secondary">
				Convert, resize, and compress images. Everything runs in your browser.
			</p>
		</header>

		<div
			class="rise mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-border py-3 font-mono text-[11px] text-text-muted"
			style="--i: 1"
		>
			<span class="flex items-center gap-2 text-success">
				<span class="h-1.5 w-1.5 bg-success"></span>
				100% local
			</span>
			<span>Your images never leave this device</span>
			<span class="hidden sm:inline">wasm-vips</span>
			<span class="ml-auto" id="image-engine-status">checking engine</span>
		</div>

		<div id="image-isolation-warning" class="note note-bad mt-4 hidden">
			<p class="font-semibold">The conversion engine can't start.</p>
			<p id="image-isolation-detail" class="mt-1"></p>
			<button id="image-isolation-reset" type="button" class="btn btn-sm mt-3">Reset and reload</button>
		</div>

		<!-- 01 / add -->
		<section class="rise mt-12" style="--i: 2">
			<h2 class="eyebrow">
				<span class="text-accent">01</span> &nbsp;Add images
			</h2>
			<label
				id="image-drop-zone"
				class="group mt-4 block cursor-pointer border-2 border-dashed border-border bg-bg-muted px-6 py-14 text-center transition hover:border-accent hover:bg-bg-surface focus-within:border-accent"
			>
				<input
					id="image-file-input"
					class="sr-only"
					type="file"
					accept="image/*,.svg,.svgz,.heic,.heif,.jxl,.tif,.tiff,.ppm,.pam,.hdr,.uhdr,.raw"
					multiple
				/>
				<svg
					class="mx-auto h-10 w-10 text-text-muted transition group-hover:-translate-y-1 group-hover:text-accent"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
					<path d="M4 19h16"></path>
				</svg>
				<span class="u-wide mt-4 block text-lg text-text-primary">Drop images here</span>
				<span class="mt-3 block text-text-secondary">
					or <span class="link">browse files</span> — pasting from the clipboard works too
				</span>
				<span class="mt-5 block font-mono text-[10px] tracking-wide text-text-muted">
					jpeg · png · webp · avif · heic · jxl · tiff · gif · svg · ppm · hdr
				</span>
			</label>
		</section>

		<!-- 02 / output -->
		<section class="rise mt-12" style="--i: 3">
			<h2 class="eyebrow">
				<span class="text-accent">02</span> &nbsp;Choose output
			</h2>

			<div class="panel mt-4 p-5 sm:p-6">
				<span class="label">Format</span>
				<div class="flex flex-wrap items-center gap-2">
					{
						primaryFormats.map((format) => (
							<label>
								<input
									type="radio"
									name="image-format"
									value={format.value}
									data-label={format.label}
									data-image-control
									class="peer sr-only"
									checked={format.checked}
								/>
								<span class={pill}>{format.label}</span>
							</label>
						))
					}
					<details class="group relative">
						<summary class="flex cursor-pointer select-none items-center gap-2 border border-border px-4 py-2 font-mono text-sm text-text-secondary transition hover:border-accent hover:text-accent [&::-webkit-details-marker]:hidden [&::marker]:content-none">
							<span id="image-more-formats-label">More formats</span>
							<span class="text-text-muted transition group-open:rotate-180">▾</span>
						</summary>
						<div class="mt-2 flex flex-wrap gap-2 sm:absolute sm:left-0 sm:top-full sm:z-10 sm:mt-1 sm:w-72 sm:border sm:border-border-strong sm:bg-bg-surface sm:p-3 sm:shadow-[0_14px_36px_-12px_rgba(21,24,31,0.22)]">
							{
								moreFormats.map((format) => (
									<label>
										<input
											type="radio"
											name="image-format"
											value={format.value}
											data-label={format.label}
											data-image-control
											class="peer sr-only"
										/>
										<span class={pillSmall}>{format.label}</span>
									</label>
								))
							}
						</div>
					</details>
				</div>
				<p id="image-format-hint" class="mt-3 font-mono text-[11px] text-text-muted"></p>

				<div id="image-quality-panel" class="mt-6 max-w-xl border-t border-border pt-5">
					<span class="flex items-baseline justify-between">
						<span class="label mb-0">Quality</span>
						<span class="font-mono text-xs text-text-muted">
							<span id="image-quality-value" class="text-accent">82</span> / 100
						</span>
					</span>
					<input
						id="image-quality"
						data-image-control
						type="range"
						min="1"
						max="100"
						value="82"
						class="mt-2.5 w-full"
					/>
					<span class="mt-1 flex justify-between font-mono text-[10px] text-text-muted">
						<span>smaller file</span>
						<span>best quality</span>
					</span>
				</div>
			</div>

			<div class="mt-4 grid gap-4 sm:grid-cols-2">
				<details class="group panel">
					<summary class={summaryStyle}>
						<span class="inline-block text-text-muted transition group-open:rotate-90">▸</span>
						Resize
						<span id="image-resize-summary" class={summaryMeta}>off</span>
					</summary>
					<div class="space-y-5 border-t border-border px-4 py-5">
						<div>
							<label class="label" for="image-resize-mode">Mode</label>
							<select id="image-resize-mode" data-image-control class="field">
								<option value="none">keep original size</option>
								<option value="fit">fit within box</option>
								<option value="fill">fill box (may crop)</option>
								<option value="exact">exact size (may stretch)</option>
								<option value="scale">scale by percent</option>
							</select>
						</div>

						<div id="image-dimensions-panel" class="hidden grid-cols-2 gap-3 [&:not(.hidden)]:grid">
							<div>
								<label class="label" for="image-width">Width px</label>
								<input id="image-width" data-image-control type="number" min="1" value="1200" class="field" />
							</div>
							<div>
								<label class="label" for="image-height">Height px</label>
								<input id="image-height" data-image-control type="number" min="1" value="1200" class="field" />
							</div>
						</div>

						<div id="image-scale-panel" class="hidden space-y-1 [&:not(.hidden)]:block">
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-scale">Scale</label>
								<span id="image-scale-value" class="font-mono text-xs text-accent">100%</span>
							</span>
							<input id="image-scale" data-image-control type="range" min="1" max="400" value="100" class="mt-2 w-full" />
						</div>

						<label class={checkRow}>
							<input id="image-upscale" data-image-control type="checkbox" />
							<span>Allow upscaling beyond original size</span>
						</label>

						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="label" for="image-kernel">Kernel</label>
								<select id="image-kernel" data-image-control class="field">
									<option value="lanczos3">lanczos3</option>
									<option value="mks2021">mks2021</option>
									<option value="mks2013">mks2013</option>
									<option value="cubic">cubic</option>
									<option value="mitchell">mitchell</option>
									<option value="linear">linear</option>
									<option value="nearest">nearest</option>
								</select>
							</div>
							<div>
								<label class="label" for="image-interesting">Focus</label>
								<select id="image-interesting" data-image-control class="field">
									<option value="attention">attention</option>
									<option value="entropy">entropy</option>
									<option value="centre">centre</option>
									<option value="low">low</option>
									<option value="high">high</option>
									<option value="none">none</option>
								</select>
							</div>
						</div>
					</div>
				</details>

				<details class="group panel">
					<summary class={summaryStyle}>
						<span class="inline-block text-text-muted transition group-open:rotate-90">▸</span>
						Crop &amp; rotate
						<span id="image-croprot-summary" class={summaryMeta}>off</span>
					</summary>
					<div class="space-y-5 border-t border-border px-4 py-5">
						<div>
							<label class="label" for="image-crop-mode">Crop</label>
							<select id="image-crop-mode" data-image-control class="field">
								<option value="none">none</option>
								<option value="manual">manual rectangle</option>
								<option value="smart">smart crop to resize box</option>
								<option value="trim">trim solid border</option>
							</select>
						</div>

						<div id="image-manual-crop-panel" class="hidden grid-cols-2 gap-3 [&:not(.hidden)]:grid">
							<div>
								<label class="label" for="image-crop-left">Left</label>
								<input id="image-crop-left" data-image-control type="number" min="0" value="0" class="field" />
							</div>
							<div>
								<label class="label" for="image-crop-top">Top</label>
								<input id="image-crop-top" data-image-control type="number" min="0" value="0" class="field" />
							</div>
							<div>
								<label class="label" for="image-crop-width">Width</label>
								<input id="image-crop-width" data-image-control type="number" min="1" value="800" class="field" />
							</div>
							<div>
								<label class="label" for="image-crop-height">Height</label>
								<input id="image-crop-height" data-image-control type="number" min="1" value="800" class="field" />
							</div>
						</div>

						<div id="image-trim-panel" class="hidden space-y-1 [&:not(.hidden)]:block">
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-trim-threshold">Trim threshold</label>
								<span id="image-trim-threshold-value" class="font-mono text-xs text-accent">10</span>
							</span>
							<input
								id="image-trim-threshold"
								data-image-control
								type="range"
								min="0"
								max="100"
								value="10"
								class="mt-2 w-full"
							/>
						</div>

						<div>
							<label class="label" for="image-rotate-mode">Rotate</label>
							<select id="image-rotate-mode" data-image-control class="field">
								<option value="none">none</option>
								<option value="d90">90° clockwise</option>
								<option value="d180">180°</option>
								<option value="d270">90° counterclockwise</option>
								<option value="custom">custom angle</option>
							</select>
						</div>
						<div id="image-custom-rotate-panel" class="hidden space-y-1 [&:not(.hidden)]:block">
							<label class="label" for="image-custom-angle">Angle °</label>
							<input id="image-custom-angle" data-image-control type="number" value="0" step="0.1" class="field" />
						</div>

						<div class="grid gap-2.5">
							<label class={checkRow}>
								<input id="image-flip-horizontal" data-image-control type="checkbox" />
								<span>Flip horizontal</span>
							</label>
							<label class={checkRow}>
								<input id="image-flip-vertical" data-image-control type="checkbox" />
								<span>Flip vertical</span>
							</label>
							<label class={checkRow}>
								<input id="image-autorotate" data-image-control type="checkbox" checked />
								<span>Auto-orient from EXIF</span>
							</label>
						</div>
					</div>
				</details>

				<details class="group panel">
					<summary class={summaryStyle}>
						<span class="inline-block text-text-muted transition group-open:rotate-90">▸</span>
						Adjust
						<span id="image-color-summary" class={summaryMeta}>off</span>
					</summary>
					<div class="space-y-5 border-t border-border px-4 py-5">
						<div class="grid gap-2.5">
							<label class={checkRow}>
								<input id="image-grayscale" data-image-control type="checkbox" />
								<span>Grayscale</span>
							</label>
							<label class={checkRow}>
								<input id="image-invert" data-image-control type="checkbox" />
								<span>Invert colors</span>
							</label>
							<label class={checkRow}>
								<input id="image-flatten" data-image-control type="checkbox" />
								<span>Flatten transparency onto background</span>
							</label>
						</div>
						<div>
							<label class="label" for="image-background">Background color</label>
							<input
								id="image-background"
								data-image-control
								type="color"
								value="#ffffff"
								class="h-10 w-full cursor-pointer border border-border bg-bg-muted p-1"
							/>
						</div>
						<div>
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-blur">Blur</label>
								<span id="image-blur-value" class="font-mono text-xs text-accent">0</span>
							</span>
							<input id="image-blur" data-image-control type="range" min="0" max="40" value="0" step="0.1" class="mt-2 w-full" />
						</div>
						<div>
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-sharpen">Sharpen</label>
								<span id="image-sharpen-value" class="font-mono text-xs text-accent">0</span>
							</span>
							<input id="image-sharpen" data-image-control type="range" min="0" max="20" value="0" step="0.1" class="mt-2 w-full" />
						</div>
						<div>
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-gamma">Gamma</label>
								<span id="image-gamma-value" class="font-mono text-xs text-accent">1.00</span>
							</span>
							<input id="image-gamma" data-image-control type="range" min="0.1" max="5" value="1" step="0.05" class="mt-2 w-full" />
						</div>
						<div>
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-brightness">Brightness</label>
								<span id="image-brightness-value" class="font-mono text-xs text-accent">0</span>
							</span>
							<input id="image-brightness" data-image-control type="range" min="-255" max="255" value="0" class="mt-2 w-full" />
						</div>
						<div>
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-contrast">Contrast</label>
								<span id="image-contrast-value" class="font-mono text-xs text-accent">100%</span>
							</span>
							<input id="image-contrast" data-image-control type="range" min="0" max="300" value="100" class="mt-2 w-full" />
						</div>
					</div>
				</details>

				<details class="group panel">
					<summary class={summaryStyle}>
						<span class="inline-block text-text-muted transition group-open:rotate-90">▸</span>
						Encoder options
						<span id="image-output-summary" class={summaryMeta}>defaults</span>
					</summary>
					<div class="space-y-5 border-t border-border px-4 py-5">
						<div>
							<span class="flex items-baseline justify-between">
								<label class="label mb-0" for="image-effort">Encoder effort</label>
								<span id="image-effort-value" class="font-mono text-xs text-accent">6</span>
							</span>
							<input id="image-effort" data-image-control type="range" min="0" max="10" value="6" class="mt-2 w-full" />
							<span class="mt-1 flex justify-between font-mono text-[10px] text-text-muted">
								<span>faster</span>
								<span>smaller file</span>
							</span>
						</div>
						<div class="grid gap-2.5">
							<label class={checkRow}>
								<input id="image-lossless" data-image-control type="checkbox" />
								<span>Lossless where the format supports it</span>
							</label>
							<label class={checkRow}>
								<input id="image-progressive" data-image-control type="checkbox" />
								<span>Progressive / interlaced</span>
							</label>
							<label class={checkRow}>
								<input id="image-keep-metadata" data-image-control type="checkbox" />
								<span>Keep EXIF / metadata</span>
							</label>
							<label class={checkRow}>
								<input id="image-favicon" data-image-control type="checkbox" />
								<span>Also build a favicon set (.ico + png sizes)</span>
							</label>
						</div>
					</div>
				</details>
			</div>
		</section>

		<!-- 03 / download -->
		<section class="rise mt-12" style="--i: 4">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
				<h2 class="eyebrow">
					<span class="text-accent">03</span> &nbsp;Download
				</h2>
				<div class="ml-auto flex flex-wrap gap-2">
					<button id="image-download-all" type="button" class="btn btn-sm btn-primary hidden">
						Download all (.zip)
					</button>
					<button id="image-process" type="button" class="btn btn-sm">Convert again</button>
					<button id="image-cancel" type="button" class="btn btn-sm btn-danger" disabled>Cancel</button>
					<button id="image-clear" type="button" class="btn btn-sm btn-danger">Clear</button>
				</div>
			</div>
			<p class="mt-2.5 text-sm text-text-muted">
				Conversion starts automatically when you add images or change settings.
			</p>
			<ul id="image-queue" class="mt-4 border-t border-border"></ul>
		</section>

		<!-- results -->
		<section id="image-results" class="mt-12 hidden">
			<h2 class="eyebrow">Result</h2>
			<div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_300px]">
				<div class="space-y-2.5">
					<div class="flex min-h-[300px] items-center justify-center border border-border bg-bg-muted p-4">
						<p id="image-preview-empty" class="text-text-muted">Output preview</p>
						<img
							id="image-preview"
							class="hidden max-h-[520px] max-w-full cursor-crosshair object-contain"
							alt="Processed output preview"
							decoding="async"
						/>
					</div>
					<p class="font-mono text-[11px] text-text-muted">
						Click the image to pick a color — picked
						<span id="image-picked-color" class="text-accent">#------</span>
					</p>
				</div>

				<div class="space-y-4">
					<div class="flex items-baseline justify-between gap-3">
						<h3 class="eyebrow">Palette</h3>
						<span class="font-mono text-[10px] text-text-muted">click to copy</span>
					</div>
					<div id="image-palette" class="grid grid-cols-2 gap-2">
						<p class="text-sm text-text-muted">Extracting…</p>
					</div>
					<div class="border-t border-border pt-4">
						<span class="flex items-baseline justify-between">
							<label class="label mb-0" for="image-palette-size">Colors</label>
							<span id="image-palette-size-value" class="font-mono text-xs text-accent">8</span>
						</span>
						<input id="image-palette-size" data-image-control type="range" min="2" max="16" value="8" class="mt-2 w-full" />
					</div>
				</div>
			</div>

			<details class="group panel mt-6">
				<summary class={summaryStyle}>
					<span class="inline-block text-text-muted transition group-open:rotate-90">▸</span>
					Metadata
				</summary>
				<div id="image-metadata" class="border-t border-border px-4 py-5">
					<p class="text-sm text-text-muted">Metadata appears after processing.</p>
				</div>
			</details>
		</section>
	</div>

	<script>
		import '@/scripts/image-tool';
	</script>
</Layout>

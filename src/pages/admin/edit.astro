---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getObjectText } from '@/lib/s3';

export const prerender = false;

const key = Astro.url.searchParams.get('key');
const saved = Astro.url.searchParams.get('saved');

let isNew = !key;
let content = '';

if (key) {
	if (key.includes('..') || !key.startsWith('mdx/')) {
		return Astro.redirect('/admin?err=1', 302);
	}
	try {
		content = await getObjectText(key);
	} catch {
		return Astro.redirect('/admin?err=1', 302);
	}
}
---

<AdminLayout title={isNew ? 'New MDX' : 'Edit MDX'}>
	<header class="rise">
		<a href="/admin" class="eyebrow transition hover:text-accent" transition:animate="none">
			&larr; Dashboard
		</a>
		<h1 class="u-wide mt-4 text-2xl text-text-primary sm:text-3xl">
			{isNew ? 'New object' : 'Edit'}
		</h1>
		{isNew ? (
			<p class="mt-3 text-[15px] text-text-secondary">Create a new post or page in S3.</p>
		) : (
			<p class="mt-3 break-all font-mono text-sm text-text-muted">{key}</p>
		)}
	</header>

	{saved ? (
		<p class="note note-ok mt-6">Saved to S3. Purge cache for the public URL if needed.</p>
	) : null}

	<form method="POST" action="/api/admin/cms-save" class="rise mt-10 space-y-6" style="--i: 1">
		{!isNew ? <input type="hidden" name="key" value={key} /> : null}

		{isNew ? (
			<>
				<div class="grid gap-6 sm:grid-cols-[12rem_minmax(0,1fr)]">
					<div>
						<label class="label" for="type-select">Type</label>
						<select name="type" id="type-select" class="field">
							<option value="blog">Blog post</option>
							<option value="page">Page</option>
						</select>
					</div>
					<div>
						<label class="label" for="title-input">Title</label>
						<input name="title" id="title-input" required placeholder="My new post" class="field" />
					</div>
				</div>

				<p class="font-mono text-xs text-text-muted">
					Key:{' '}
					<code id="derived-key" class="bg-bg-subtle px-2 py-1 text-accent-light">
						mdx/blogs/{new Date().toISOString().slice(0, 10)}-my-new-post.mdx
					</code>
				</p>
			</>
		) : null}

		<div>
			<label class="label" for="content-input">Content</label>
			<textarea
				id="content-input"
				name="content"
				required
				rows={isNew ? 20 : 26}
				spellcheck="false"
				class="field resize-y leading-relaxed"
			>{
				isNew
					? `---\ntitle: New post\ndate: ${new Date().toISOString().slice(0, 10)}\n---\n\nHello from **markdown**.`
					: content
			}</textarea>
		</div>

		<div class="flex flex-wrap items-center gap-5 border-t border-border pt-6">
			<button type="submit" class="btn btn-primary">Save</button>
			<a href="/admin" class="eyebrow transition hover:text-accent" transition:animate="none">
				&larr; Back to list
			</a>
		</div>
	</form>

	{isNew ? (
		<script is:inline>
			(function () {
				const typeSelect = document.getElementById('type-select');
				const titleInput = document.getElementById('title-input');
				const keyDisplay = document.getElementById('derived-key');

				function slugify(str) {
					return str
						.toLowerCase()
						.trim()
						.replace(/[^a-z0-9]+/g, '-')
						.replace(/^-+|-+$/g, '');
				}

				function updateKey() {
					const title = titleInput.value || 'my-new-post';
					const slug = slugify(title);
					const type = typeSelect.value;
					if (type === 'blog') {
						const date = new Date().toISOString().slice(0, 10);
						keyDisplay.textContent = 'mdx/blogs/' + date + '-' + slug + '.mdx';
					} else {
						keyDisplay.textContent = 'mdx/' + slug + '.mdx';
					}
				}

				typeSelect.addEventListener('change', updateKey);
				titleInput.addEventListener('input', updateKey);
				updateKey();
			})();
		</script>
	) : null}
</AdminLayout>

---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getFileIndex } from '@/lib/file-index';

export const prerender = false;

const err = Astro.url.searchParams.get('err');
const deleted = Astro.url.searchParams.get('deleted');
const collision = Astro.url.searchParams.get('collision');
const done = Astro.url.searchParams.get('done');
const rebuilt = Astro.url.searchParams.get('rebuilt');

const index = await getFileIndex();
const keys = index.map((e) => e.key).sort();
---

<AdminLayout title="Admin">
	<div class="rise flex flex-wrap items-end justify-between gap-6">
		<div>
			<h1 class="u-wide text-2xl text-text-primary sm:text-3xl">Dashboard</h1>
			<p class="mt-3 text-[15px] text-text-secondary">Manage MDX files and edge cache.</p>
		</div>
		<a href="/admin/edit" class="btn btn-primary" transition:animate="none">New object</a>
	</div>

	<div class="mt-6 space-y-2">
		{err ? <p class="note note-bad">Something went wrong (S3 or validation).</p> : null}
		{deleted ? <p class="note note-ok">Object deleted.</p> : null}
		{collision ? <p class="note note-bad">An object with that name already exists.</p> : null}
		{done !== null ? (
			<p class="note note-ok">Removed {done} cache entries (best-effort; false = miss or not stored).</p>
		) : null}
		{rebuilt !== null ? (
			<p class="note note-ok">
				Rebuilt file index ({rebuilt} objects). Purge cache separately if public pages are stale.
			</p>
		) : null}
	</div>

	<!-- Objects -->
	<section class="rise mt-12" style="--i: 1">
		<div class="flex flex-wrap items-baseline justify-between gap-4">
			<h2 class="u-wide text-base text-text-primary">Objects</h2>
			<div class="flex items-baseline gap-5">
				<span class="eyebrow">{keys.length} in mdx/</span>
				<a href="/admin/files" class="eyebrow transition hover:text-accent" transition:animate="none">
					File browser &rarr;
				</a>
			</div>
		</div>

		<ul class="mt-6 border-t border-border">
			{
				keys.length === 0 ? (
					<li class="py-10">
						<p class="text-lg text-text-secondary">No objects under mdx/ yet.</p>
						<p class="mt-2 text-text-muted">Create one to get started.</p>
					</li>
				) : (
					keys.map((k) => (
						<li class="obj group flex flex-wrap items-center justify-between gap-3">
							<a
								class="min-w-0 flex-1 truncate font-mono text-sm text-text-primary transition group-hover:text-accent"
								href={`/admin/edit?key=${encodeURIComponent(k)}`}
								transition:animate="none"
							>
								{k}
							</a>
							<form
								method="POST"
								action="/api/admin/cms-delete"
								class="shrink-0"
								data-confirm="Delete this object?"
							>
								<input type="hidden" name="key" value={k} />
								<button type="submit" class="btn btn-sm btn-danger">
									Delete
								</button>
							</form>
						</li>
					))
				)
			}
		</ul>
	</section>

	<!-- Maintenance -->
	<section class="rise mt-14 grid gap-6 md:grid-cols-2" style="--i: 2">
		<div class="panel p-6">
			<h2 class="u-wide text-base text-text-primary">File index</h2>
			<p class="mt-3 text-text-secondary">
				Rebuilds the KV listing of <code class="font-mono text-sm text-accent">mdx/</code> from S3. Does not
				purge the edge cache.
			</p>
			<form
				method="POST"
				action="/api/admin/fs/rebuild-index"
				class="mt-5"
				data-confirm="Rebuild the MDX file index from S3?"
			>
				<button type="submit" class="btn">Rebuild index</button>
			</form>
		</div>

		<div class="panel border-error/30 bg-error/5 p-6">
			<h2 class="u-wide text-base text-error">Danger zone</h2>
			<p class="mt-3 text-text-secondary">Clears all cached public pages derived from the content index.</p>
			<form method="POST" action="/api/admin/purge" class="mt-5" data-confirm="Purge all cached pages?">
				<button type="submit" class="btn btn-danger">Purge all cache</button>
			</form>
		</div>
	</section>
</AdminLayout>

<script>
	for (const form of document.querySelectorAll('form[data-confirm]')) {
		form.addEventListener('submit', (event) => {
			const message = form.getAttribute('data-confirm');
			if (message && !window.confirm(message)) {
				event.preventDefault();
			}
		});
	}
</script>

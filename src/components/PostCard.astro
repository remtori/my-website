---
import ObjectRow from './ObjectRow.astro';

interface Props {
	href: string;
	title: string;
	date?: string;
	dataAttrs?: Record<string, string>;
}

const { href, title, date, dataAttrs } = Astro.props;
---

<li class="blog-row" {...dataAttrs}>
	<ObjectRow href={href} title={title} meta={date} tag="Writing" />
</li>

---
import { loadMdFromS3 } from '@/lib/md-content';
import MdBody from './MdBody.astro';

interface Props {
	s3Path: string;
}

const { s3Path } = Astro.props;
const { html, title, date, found } = await loadMdFromS3(s3Path);
---

{
	found ? (
		<article>
			<header class="rise">
				{date ? <p class="eyebrow">{date}</p> : null}
				<h1 class="u-title mt-2 text-3xl text-text-primary sm:text-4xl">{title}</h1>
			</header>
			<div class="rise mt-9" style="--i: 1">
				<MdBody {html} />
			</div>
		</article>
	) : (
		<slot name="fallback" />
	)
}

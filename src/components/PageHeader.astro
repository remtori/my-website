---
interface Props {
	title: string;
	subtitle?: string;
	size?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { title, subtitle, size = 'sm', class: className } = Astro.props;

const sizeClass = {
	sm: 'text-xl sm:text-2xl',
	md: 'text-2xl sm:text-3xl',
	lg: 'text-3xl sm:text-4xl',
}[size];
---

<header class:list={['rise', className]}>
	<h1 class:list={['u-wide text-text-primary', sizeClass]}>{title}</h1>
	{subtitle ? <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-text-secondary">{subtitle}</p> : null}
	<slot name="subtitle" />
	<slot />
</header>
